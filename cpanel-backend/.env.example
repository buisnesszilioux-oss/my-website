# M.I. Engineering Works — Environment variables reference
#
# DO NOT upload this file to cPanel. Instead, add each variable below in:
#   cPanel → Setup Node.js App → click your app → Environment variables
#
# ============== REQUIRED ==============

# PostgreSQL connection string. Free options:
#   • Neon (recommended): https://neon.tech  →  Create project, copy "Pooled connection"
#   • Supabase: https://supabase.com  →  Project Settings → Database → URI
#
# IMPORTANT: include `?sslmode=require` at the end. Strip `&channel_binding=require`
# if the driver complains (the bundled server already handles this automatically).
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Admin email(s) allowed to sign into /admin. Comma-separated for multiple.
ADMIN_USERNAME=youremail@example.com

# Master admin password. Use a strong, unique 12+ character password.
# This is also accepted as a fallback if a user forgets their own password
# (only for emails listed in ADMIN_USERNAME above).
ADMIN_PASSWORD=replace-with-strong-password

# JWT signing secret. Generate locally with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Paste the output below.
JWT_SECRET=replace-with-96-char-random-hex

# Always "production" on cPanel.
NODE_ENV=production


# ============== OPTIONAL ==============

# Google Sign-In (admin + user). Get from https://console.cloud.google.com
#   → APIs & Services → Credentials → OAuth 2.0 Client ID (Web application)
# GOOGLE_CLIENT_ID=123456789-abcdefg.apps.googleusercontent.com

# SMTP for contact-form emails (Gmail, Mailgun, SendGrid, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=youremail@gmail.com
# SMTP_PASS=app-password-not-your-gmail-password
# CONTACT_TO_EMAIL=where-quote-requests-should-arrive@example.com

# Disable the auto-seed (only do this if you want a totally empty DB).
# AUTO_SEED=false

# Override the listening port. cPanel/Passenger ignores this; only useful for VPS.
# PORT=3001

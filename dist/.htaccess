# M.I. Engineering Works — frontend (public_html)
# ─────────────────────────────────────────────────
# 1. /api/* aur /uploads/* requests Node.js backend par bhejo
# 2. Baaki sab routes React Router ke liye index.html par bhejo
# 3. Static files (JS / CSS / images) ko long-cache karo

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ── API + uploads proxy ─────────────────────────────────────────────────
  # Agar backend SAME domain par hai (e.g. /api on same host) — yeh line
  # rakho. Apache + mod_proxy hone par yeh seedha Node.js app ke port
  # 3000 (ya jo bhi cPanel ne assign kiya) par forward karega.
  #
  # Agar backend SUBDOMAIN par hai (e.g. api.yourdomain.com) to in 2
  # lines ko comment kar do aur frontend/backend ek hi domain par chalao
  # ya CORS handle karke API_BASE_URL set karo.
  RewriteRule ^api/(.*)$       http://127.0.0.1:3000/api/$1 [P,L]
  RewriteRule ^uploads/(.*)$   http://127.0.0.1:3000/uploads/$1 [P,L]

  # ── React Router fallback ───────────────────────────────────────────────
  # Asli files / folders ko jaane do, baaki sab par index.html serve karo.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# ── Cache headers ─────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html               "access plus 0 seconds"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/jpg               "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 month"
  ExpiresByType image/x-icon            "access plus 1 year"
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType application/font-woff2  "access plus 1 year"
</IfModule>

# ── Security headers ──────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Block hidden files (.env, .git, etc.)
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Copy to `.env` and fill in. NEVER commit your real .env file.

# PostgreSQL connection (required)
DATABASE_URL=postgres://user:pass@host/dbname

# Admin login (optional — defaults shown below)
ADMIN_USERNAME=miengineering@gmail.com
ADMIN_PASSWORD=change-me
JWT_SECRET=please-change-to-a-long-random-string

# Outgoing contact email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=M.I. Engineering <youremail@gmail.com>
SMTP_TO=youremail@gmail.com

# Copy this file to `.env` and fill in real values. NEVER commit `.env` itself.

# ─── Server ───────────────────────────────────────────────────────────────────
# Port the server listens on. Most hosts (Render / cPanel / Heroku) inject this
# automatically; only set it manually for local development.
PORT=3000

# Set to "production" when deploying. Locally you can leave it unset.
# NODE_ENV=production

# ─── Database (REQUIRED) ──────────────────────────────────────────────────────
# Without this the admin panel cannot save hero images, grade chart, products,
# site content, etc. — those features need a working PostgreSQL database.
# Free options: https://neon.tech  or  https://supabase.com
DATABASE_URL=postgres://user:pass@host:5432/dbname

# ─── Admin login ──────────────────────────────────────────────────────────────
ADMIN_USERNAME=miengineering@gmail.com
ADMIN_PASSWORD=change-me-to-a-strong-password
JWT_SECRET=please-change-to-a-long-random-string

# ─── Google sign-in (optional) ────────────────────────────────────────────────
# Same client ID is used in both vars. VITE_ prefix exposes it to the browser.
# Leave blank to disable Google login (email/password still works).
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# ─── Outgoing contact email (optional) ────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=M.I. Engineering <youremail@gmail.com>
SMTP_TO=youremail@gmail.com
